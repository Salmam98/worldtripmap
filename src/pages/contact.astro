---
import Page from '../layouts/Page.astro';
import { SITE } from '../lib/site';

const hasForm = Boolean(SITE.contactEndpoint);
---

<Page
  title="Contact WorldTripMap"
  description="Get in touch with WorldTripMap about a correction, a question, or the map you would like to see next."
  h1="Contact"
  lede="Corrections, questions and requests for new maps are all welcome."
  crumb="Contact"
  path="/contact/"
>
  <p>
    Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>{hasForm ? ', or use the form below.' : '.'}
  </p>
  <p>
    If you are reporting something wrong on a map, it helps to say which map, which place, and what you expected to see. Please do not
    send personal details you would not want read.
  </p>

  {
    hasForm && (
      <form class="contact" id="contact-form" action={SITE.contactEndpoint} method="post" novalidate>
        <div class="field">
          <label class="field__label" for="contact-name">
            Your name
          </label>
          <input class="input" id="contact-name" name="name" type="text" autocomplete="name" maxlength="80" required />
        </div>
        <div class="field">
          <label class="field__label" for="contact-email">
            Email address
          </label>
          <input class="input" id="contact-email" name="email" type="email" autocomplete="email" maxlength="120" required />
          <span class="field__hint">Only used to reply to you.</span>
        </div>
        <div class="field">
          <label class="field__label" for="contact-message">
            Message
          </label>
          <textarea class="textarea" id="contact-message" name="message" rows="6" maxlength="3000" required />
        </div>
        {/* Spam protection without a third-party script: a field people never see, and a minimum time on the page. */}
        <div class="contact__trap" aria-hidden="true">
          <label for="contact-website">Leave this field empty</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="btn btn--forest" type="submit">
          Send message
        </button>
        <p class="contact__status" id="contact-status" role="status" aria-live="polite" />
      </form>
    )
  }
</Page>

{
  hasForm && (
    <script is:inline>
      (function () {
        var form = document.getElementById('contact-form');
        var status = document.getElementById('contact-status');
        if (!form || !status) return;
        var opened = Date.now();
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          var data = new FormData(form);
          var name = String(data.get('name') || '').trim();
          var email = String(data.get('email') || '').trim();
          var message = String(data.get('message') || '').trim();
          if (data.get('website') || Date.now() - opened < 3000) {
            status.textContent = 'Thanks. Your message has been sent.';
            form.reset();
            return;
          }
          if (!name || !message || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            status.textContent = 'Please add your name, a valid email address and a message.';
            return;
          }
          var button = form.querySelector('button[type="submit"]');
          button.disabled = true;
          status.textContent = 'Sending…';
          fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ name: name.slice(0, 80), email: email.slice(0, 120), message: message.slice(0, 3000) }),
          })
            .then(function (response) {
              if (!response.ok) throw new Error('failed');
              status.textContent = 'Thanks. Your message has been sent.';
              form.reset();
            })
            .catch(function () {
              status.textContent = 'The message could not be sent. Please email us instead.';
            })
            .then(function () {
              button.disabled = false;
            });
        });
      })();
    </script>
  )
}

<style>
  .contact {
    display: grid;
    gap: 1.1rem;
    margin-top: 2rem;
    padding: clamp(1.1rem, 3vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
    justify-items: start;
  }
  .contact .field {
    width: 100%;
  }
  .contact__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact__status {
    font-size: 0.9375rem;
    font-weight: 600;
    min-height: 1.5rem;
  }
</style>
