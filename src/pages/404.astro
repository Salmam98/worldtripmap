---
import MiniMap from '../components/MiniMap.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | WorldTripMap" description="That page is not on the map. Here is the way back." noindex>
  <section class="section lost">
    <div class="wrap lost__inner">
      <div class="lost__map">
        <MiniMap map="world" />
      </div>
      <div class="lost__text">
        <h1>This page is not on the map</h1>
        <p class="lede">The address may have changed, or the link may be incomplete. Your saved maps are not affected.</p>
        <ul>
          <li><a class="text-link" href="/maps/">Choose a map</a></li>
          <li><a class="text-link" href="/travel-map-poster/">Make a poster</a></li>
          <li><a class="text-link" href="/guides/">Read the guides</a></li>
          <li><a class="text-link" href="/">Go to the home page</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 52rem) {
    .lost__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .lost__map {
    opacity: 0.8;
  }
  .lost__text {
    display: grid;
    gap: 1.25rem;
  }
  .lost__text ul {
    display: grid;
    gap: 0.7rem;
    list-style: none;
  }
</style>
