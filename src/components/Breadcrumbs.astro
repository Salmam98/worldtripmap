---
import type { Crumb } from '../lib/seo';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((crumb, i) => (
        <li>
          {i < crumbs.length - 1 ? (
            <a href={crumb.path}>{crumb.name}</a>
          ) : (
            <span aria-current="page">{crumb.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
