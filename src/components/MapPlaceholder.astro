---
/**
 * The map tool as it first appears, drawn when the site is built. It stands in for the
 * interactive map until that has loaded, so the page has its final shape from the first paint and
 * nothing moves when the real one takes over. It is the same component as the live tool, in its
 * "shell" mode, with a coarse picture in place of the interactive map. The live tool removes this
 * element in the frame it first appears (see ErrorBoundary.tsx).
 *
 * Use it beside the island, inside an element marked data-island-host.
 */
import { CANADA_PLACES } from '../data/definitions/canada-places';
import citiesMeta from '../data/maps/canada-cities.meta.json';
import canadaMeta from '../data/maps/canada.meta.json';
import canada from '../data/maps/canada.preview.json';
import worldArt from '../data/maps/world.art.json';
import worldMeta from '../data/maps/world.meta.json';
import { MapApp } from '../islands/map/MapApp';
import { MAP_OPTIONS } from '../islands/map/options';
import { MAPS } from '../lib/maps/registry';
import type { MapGeoMeta, MapGeometry, MapId } from '../lib/maps/types';

interface Props {
  map: MapId;
}

const { map } = Astro.props;
const def = MAPS[map];
const meta = (map === 'world' ? worldMeta : map === 'canada' ? canadaMeta : citiesMeta) as unknown as MapGeoMeta;
const picture =
  map === 'world'
    ? { land: Object.values(worldArt.shapes).join('') + worldArt.rest, outline: worldArt.outline }
    : { land: Object.values(canada.shapes).join(''), backdrop: map === 'canada-cities' };
// The shell never draws the detailed geometry, so none is loaded for it.
const geometry: MapGeometry = { id: map, lod: 'preview', width: meta.width, height: meta.height, shapes: {} };
---

<div data-placeholder>
  <MapApp
    def={def}
    meta={meta}
    geometry={geometry}
    layout={MAP_OPTIONS[map].layout}
    places={map === 'canada' ? CANADA_PLACES : undefined}
    shell={picture}
  />
</div>
