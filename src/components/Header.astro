---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  tone?: 'light' | 'navy';
}

const { tone = 'light' } = Astro.props;
const current = Astro.url.pathname;

const links = [
  { href: '/maps/', label: 'Explore maps' },
  { href: '/guides/', label: 'Travel inspiration' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/about/', label: 'About' },
];
---

<header class:list={['site-header', tone === 'navy' && 'site-header--navy on-navy']}>
  <div class="wrap site-header__bar">
    <a class="site-header__brand" href="/" aria-label="WorldTripMap home">
      <Logo />
    </a>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <Icon name="menu" size={22} />
      <span>Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current === link.href ? 'page' : current.startsWith(link.href) ? 'true' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class:list={['btn', 'btn--sm', tone === 'navy' ? 'btn--gold' : '']} href="/maps/">Create my map</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.querySelector('.site-header__toggle');
    var nav = document.getElementById('site-nav');
    if (!toggle || !nav) return;
    document.documentElement.classList.add('has-nav-toggle');
    toggle.hidden = false;
    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
        toggle.focus();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .site-header--navy {
    background: var(--navy-900);
    color: var(--ivory-50);
    border-bottom-color: rgb(248 246 240 / 0.1);
    --ink: var(--ivory-50);
    --line-strong: rgb(248 246 240 / 0.26);
    --focus: var(--gold-500);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    min-height: 4.25rem;
    padding-block: 0.6rem;
  }
  .site-header__brand {
    display: inline-flex;
    text-decoration: none;
    padding-block: 0.25rem;
  }
  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
  }
  .site-nav li a {
    display: inline-block;
    padding: 0.6rem 0;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s var(--ease);
  }
  .site-nav li a:hover {
    border-bottom-color: var(--gold-500);
  }
  .site-nav li a[aria-current] {
    border-bottom-color: currentColor;
  }
  .site-header__toggle {
    display: none;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: transparent;
    color: inherit;
    font-weight: 650;
    font-size: 0.9375rem;
  }

  @media (max-width: 56rem) {
    :global(.has-nav-toggle) .site-header__toggle:not([hidden]) {
      display: inline-flex;
    }
    :global(.has-nav-toggle) .site-nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding-bottom: 1rem;
    }
    :global(.has-nav-toggle) .site-nav.is-open {
      display: flex;
    }
    :global(.has-nav-toggle) .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    :global(.has-nav-toggle) .site-nav li a {
      display: block;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.0625rem;
    }
    :global(.has-nav-toggle) .site-nav .btn {
      min-height: 2.875rem;
    }
  }
</style>
