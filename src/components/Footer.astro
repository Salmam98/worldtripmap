---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Maps',
    links: [
      { href: '/maps/world/', label: 'World: countries' },
      { href: '/maps/canada/', label: 'Canada: provinces and territories' },
      { href: '/maps/canada-cities/', label: 'Canada: major cities' },
      { href: '/maps/', label: 'All maps' },
    ],
  },
  {
    title: 'Make and learn',
    links: [
      { href: '/travel-map-poster/', label: 'Travel map posters' },
      { href: '/how-it-works/', label: 'How it works' },
      { href: '/guides/', label: 'Travel inspiration' },
      { href: '/methodology/', label: 'Data and methods' },
    ],
  },
  {
    title: 'WorldTripMap',
    links: [
      { href: '/about/', label: 'About' },
      { href: '/contact/', label: 'Contact' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
    ],
  },
];
---

<footer class="site-footer section--navy">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" aria-label="WorldTripMap home"><Logo /></a>
      <p>
        Mark where you have been, see how far you have come, and make a map worth keeping. Free to use, with
        no account.
      </p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap site-footer__base">
    <p>© {year} {SITE.name}. Your maps stay on your device.</p>
    <p>
      Map data from <a href="https://www.naturalearthdata.com/" rel="noopener">Natural Earth</a>, public domain.{' '}
      <a href="/methodology/">How we count</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    font-size: 0.9375rem;
  }
  .site-footer__grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
  .site-footer__brand a {
    display: inline-flex;
    text-decoration: none;
  }
  .site-footer__brand p {
    margin-top: 1rem;
    max-width: 24rem;
    color: var(--ink-2);
  }
  .site-footer h2 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--gold-500);
    margin-bottom: 0.75rem;
  }
  .site-footer ul {
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }
  .site-footer li a {
    display: inline-block;
    padding: 0.35rem 0;
    text-decoration: none;
  }
  .site-footer li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold-500);
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .site-footer__base a {
    color: var(--ivory-50);
  }
</style>
