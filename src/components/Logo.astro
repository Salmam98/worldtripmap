---
/**
 * The WorldTripMap mark: a globe with one gore filled in, the way a traveller fills in a map.
 * The gold never changes; the line work takes the current text colour.
 */
interface Props {
  size?: number;
  wordmark?: boolean;
}

const { size = 30, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M16 3a5.600 13 0 0 1 0 26z" fill="#C6A66B"></path>
    <g fill="none" stroke="currentColor" stroke-width="1.700" stroke-linecap="round">
      <circle cx="16" cy="16" r="13"></circle>
      <path d="M16 3a5.600 13 0 0 0 0 26M16 3a5.600 13 0 0 1 0 26M16 3v26M4.200 11h23.600M4.200 21h23.600"></path>
    </g>
  </svg>
  {wordmark && <span class="logo__word">WorldTripMap</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
  }
  .logo__word {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
</style>
