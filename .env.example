# Copy to .env (local) or set these in your host's dashboard. All are optional.
# Only variables that start with PUBLIC_ reach the browser, and none of them is a secret.

# Canonical origin, without a trailing slash. Used for canonical URLs, the sitemap and share links.
SITE_URL=https://worldtripmap.com

# Address shown on the Contact, Privacy and Terms pages. Create this mailbox before launch.
PUBLIC_CONTACT_EMAIL=hello@worldtripmap.com

# Contact form. Leave empty to show the email address only (no form is rendered).
# Any endpoint that accepts a JSON POST works, e.g. Formspree or Web3Forms.
PUBLIC_CONTACT_ENDPOINT=

# Analytics. "none" (default), "plausible" or "ga4".
PUBLIC_ANALYTICS=none
# Plausible: the domain you registered, e.g. worldtripmap.com
PUBLIC_PLAUSIBLE_DOMAIN=
# Plausible script URL, if you self-host or proxy it.
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Loads only after the visitor accepts.
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification code (the content="..." value only).
PUBLIC_GSC_VERIFICATION=

# Content Security Policy. On by default: pages may only load from, and send data to, this site
# (plus the analytics and contact-form services chosen above). Set to "off" only if you add a
# third-party service the policy would block, such as an ad network.
PUBLIC_CSP=on
